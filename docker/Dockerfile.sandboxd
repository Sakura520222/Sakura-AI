# Sakura AI Agent sandbox daemon image.
#
# This is intentionally a separate image from both the Web image and the
# untrusted runner image.  The daemon is the only container allowed to receive
# the host Docker API socket; the runner image contains no Docker client or
# application source.  start.sh launches this image independently (it is not a
# Compose service) so the Web lifecycle cannot accidentally inherit the socket.

ARG SAKURA_BUILD_VERSION=unknown
ARG SAKURA_BUILD_REVISION=unknown
ARG SAKURA_BUILD_CREATED=1970-01-01T00:00:00Z
ARG SAKURA_BUILD_CHANNEL=unknown

FROM python:3.14-slim-bookworm@sha256:416f0db2a2b561945630cef9877a7ea0581b27449eb9fd9df42f03e1b74b5b63

ARG SAKURA_BUILD_VERSION=unknown
ARG SAKURA_BUILD_REVISION=unknown
ARG SAKURA_BUILD_CREATED=1970-01-01T00:00:00Z
ARG SAKURA_BUILD_CHANNEL=unknown

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HOME=/root \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

LABEL org.opencontainers.image.source="https://github.com/Sakura520222/Sakura-AI" \
      org.opencontainers.image.version="${SAKURA_BUILD_VERSION}" \
      org.opencontainers.image.revision="${SAKURA_BUILD_REVISION}" \
      org.opencontainers.image.created="${SAKURA_BUILD_CREATED}" \
      com.sakura-ai.build.channel="${SAKURA_BUILD_CHANNEL}" \
      com.sakura-ai.component="sandboxd"

# The daemon invokes the host Docker CLI through the mounted API socket.  It
# runs as root only for the narrow purpose of that socket and of applying the
# independently configured UDS group/mode; the untrusted runner is a different
# image and is always started as UID/GID 65532.
RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        ca-certificates \
        docker.io \
        tini \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/sakura-ai-sandboxer
COPY sandboxer/pyproject.toml ./pyproject.toml
COPY sandboxer/src ./src
RUN python -m pip install --no-cache-dir .

RUN install -d -m 0750 /run/sakura-ai-sandbox /var/lib/sakura-ai-sandbox

ENTRYPOINT ["/usr/bin/tini", "--", "sakura-ai-sandboxd"]
