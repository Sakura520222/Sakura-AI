# Controlled updater packaging sources (the global build/ rule must not hide them)
!updater/build/
!updater/build/*.spec
!updater/build/*.sh
!updater/build/*.py
!updater/build/*.txt
updater/build/build/
updater/build/dist/
updater/build/.pyinstaller/

# Sakura AI deploy runtime（仅保留 example 模板；真实 deployment.env 与 updater 运行时文件忽略）
.deploy/*
!.deploy/deployment.env.example
